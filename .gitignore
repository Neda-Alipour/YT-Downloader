__pycache__/
*.py[cod]
*$py.class

# PyInstaller & Build artifacts
build/
dist/
*.spec

# Bundled heavy binaries (should be downloaded or published via GitHub Releases)
bin/*.exe
bin/*.zip

# Virtual environments
venv/
.venv/
env/

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
